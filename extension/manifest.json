{
  "manifest_version": 3,
  "name": "Effigy Assist (Local)",
  "version": "0.1.1",
  "description": "User-selected tab assistance through a local native host.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Start or pause Effigy for this tab"
  },
  "commands": {
    "toggle-assistance": {
      "description": "Start or pause assistance in the active tab"
    }
  },
  "icons": {}
}
